+static void ttg_front_tap_copy_bpu(FrontTapBpuOut &d, const BPU_TOP::OutputPayload &o) {
+    d.fetch_address = o.fetch_address;
+    d.icache_read_valid = o.icache_read_valid;
+    d.predict_next_fetch_address = o.predict_next_fetch_address;
+    d.PTAB_write_enable = o.PTAB_write_enable;
+    for (int i = 0; i < FETCH_WIDTH; i++) {
+        d.pred_dir[i] = o.out_pred_dir[i];
+        d.alt_pred[i] = o.out_alt_pred[i];
+        d.pcpn[i] = o.out_pcpn[i];
+        d.altpcpn[i] = o.out_altpcpn[i];
+        for (int j = 0; j < TN_MAX; j++) {
+            d.tage_tags[i][j] = o.out_tage_tags[i][j];
+            d.tage_idxs[i][j] = o.out_tage_idxs[i][j];
+        }
+        d.sc_used[i] = o.out_sc_used[i];
+        d.sc_pred[i] = o.out_sc_pred[i];
+        d.sc_sum[i] = o.out_sc_sum[i];
+        for (int t = 0; t < BPU_SCL_META_NTABLE; ++t) d.sc_idx[i][t] = o.out_sc_idx[i][t];
+        d.loop_used[i] = o.out_loop_used[i];
+        d.loop_hit[i] = o.out_loop_hit[i];
+        d.loop_pred[i] = o.out_loop_pred[i];
+        d.loop_idx[i] = o.out_loop_idx[i];
+        d.loop_tag[i] = o.out_loop_tag[i];
+    }
+    d.pred_base_pc = o.out_pred_base_pc;
+    d.update_queue_full = o.update_queue_full;
+    d.two_ahead_valid = o.two_ahead_valid;
+    d.two_ahead_target = o.two_ahead_target;
+    d.mini_flush_req = o.mini_flush_req;
+    d.mini_flush_correct = o.mini_flush_correct;
+    d.mini_flush_target = o.mini_flush_target;
+}
