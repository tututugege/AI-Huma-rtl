+// Read-only recording tap of the AXI interconnect + LLC (added for the RTL trace harness, refsim only).
+//
+// One CPU cycle = 16 ticks (tick 0 = cycle(), ticks 1..15 = run_extra_axi_subsystem_ticks()); the interconnect and
+// the LLC run on every tick. Per tick the AXI_Interconnect runs   comb_outputs -> (masters drive) -> comb_inputs -> seq
+// and the tap records, with names a_* / b_* / o1_* / o2_* / d_*:
+//   a_*   master request fields as visible to comb_outputs()   (stale: whatever the previous driver left in the ports)
+//   d_*   DDR slave-side signals (arready/rvalid/.../bvalid) as sampled at comb_outputs()  (= inputs from sim_ddr)
+//   o1_*  outputs after comb_outputs(): resp valid/id/data, req.accepted(+id), write resp, DDR rready/bready
+//   b_*   master request fields as seen by comb_inputs() (the real per-tick requests) + resp.ready
+//   o2_*  outputs after comb_inputs(): req.ready, DDR AR/AW/W channels (what sim_ddr receives)
+// Active only when $TTG_REC_END is set (same switch as the DCache-domain tap); it only COPIES values.
+// spec expressions:  TTG_AXI.t[TTG_MS.cur].<field>
+#pragma once
+#include "AXI_Interconnect.h"
+#include <cstdint>
+
+constexpr int TTG_AXI_TICKS = 16;
+constexpr int TTG_AXI_RD = 4;   // read masters
+constexpr int TTG_AXI_WR = 2;   // write masters
+constexpr int TTG_AXI_RW = 16;  // words visible per upstream data beat (64 B)
+constexpr int MAX_OUTSTANDING_TAP = 8;  // LLC MSHR slots visible (CONFIG_AXI_LLC_MSHR_NUM)
+
+struct AxiTapReq {  // one master read request (as seen on read_ports[i].req)
+  bool valid = false;
+  uint32_t addr = 0;
+  uint8_t size = 0, id = 0;
+  bool bypass = false;
+};
+struct AxiTapWReq {
+  bool valid = false;
+  uint32_t addr = 0;
+  uint32_t wdata[TTG_AXI_RW] = {};
+  uint64_t wstrb = 0;
+  uint8_t size = 0, id = 0;
+  bool bypass = false;
+};
+struct AxiTapDdrSlave {  // sim_ddr -> interconnect
+  bool arready = false, rvalid = false, awready = false, wready = false, bvalid = false, rlast = false;
+  uint8_t rid = 0, bid = 0, rresp = 0, bresp = 0;
+  uint32_t rdata[8] = {};
+};
+struct AxiTapDdrMaster {  // interconnect -> sim_ddr
+  bool arvalid = false, awvalid = false, wvalid = false, wlast = false, rready = false, bready = false;
+  uint8_t arid = 0, arlen = 0, arsize = 0, arburst = 0, awid = 0, awlen = 0, awsize = 0, awburst = 0;
+  uint32_t araddr = 0, awaddr = 0;
+  uint32_t wdata[8] = {};
+  uint32_t wstrb = 0;
+};
+
+// LLC state visible to the interconnect (hazard / id-conflict checks read llc.io.regs directly) + what the LLC sees.
+struct AxiTapLlc {
+  bool lookup_valid = false, lookup_is_write = false;
+  uint32_t lookup_addr = 0;
+  uint8_t lookup_master = 0, lookup_id = 0;
+  bool read_resp_valid[TTG_AXI_RD] = {}, read_resp_fresh[TTG_AXI_RD] = {};
+  uint8_t read_resp_id[TTG_AXI_RD] = {}, read_resp_q_count[TTG_AXI_RD] = {};
+  bool mshr_valid[MAX_OUTSTANDING_TAP] = {}, mshr_is_write[MAX_OUTSTANDING_TAP] = {}, mshr_is_prefetch[MAX_OUTSTANDING_TAP] = {};
+  uint8_t mshr_master[MAX_OUTSTANDING_TAP] = {}, mshr_id[MAX_OUTSTANDING_TAP] = {};
+  uint32_t mshr_line_addr[MAX_OUTSTANDING_TAP] = {};
+  bool write_ctx_valid[TTG_AXI_WR] = {};
+  uint32_t write_ctx_line_addr[TTG_AXI_WR] = {};
+  bool write_resp_valid[TTG_AXI_WR] = {};
+  uint32_t write_resp_line_addr[TTG_AXI_WR] = {};
+  uint8_t write_q_count[TTG_AXI_WR] = {};
+  bool victim_wb_valid = false;
+  uint8_t read_victim_wb_q_count = 0;
+};
+
+struct AxiTapTick {
+  bool valid = false;
+  // ---- as seen at comb_outputs ----
+  AxiTapReq a_rd[TTG_AXI_RD];
+  AxiTapWReq a_wr[TTG_AXI_WR];
+  AxiTapDdrSlave d_ddr, d_mmio;
+  // ---- outputs after comb_outputs ----
+  bool o1_rd_resp_valid[TTG_AXI_RD] = {};
+  uint8_t o1_rd_resp_id[TTG_AXI_RD] = {};
+  uint32_t o1_rd_resp_data[TTG_AXI_RD][TTG_AXI_RW] = {};
+  bool o1_rd_req_ready[TTG_AXI_RD] = {};
+  bool o1_rd_accepted[TTG_AXI_RD] = {};
+  uint8_t o1_rd_accepted_id[TTG_AXI_RD] = {};
+  bool o1_wr_req_ready[TTG_AXI_WR] = {};
+  bool o1_wr_accepted[TTG_AXI_WR] = {};
+  bool o1_wr_resp_valid[TTG_AXI_WR] = {};
+  uint8_t o1_wr_resp_id[TTG_AXI_WR] = {};
+  uint8_t o1_wr_resp_resp[TTG_AXI_WR] = {};
+  bool o1_ddr_rready = false, o1_ddr_bready = false, o1_mmio_rready = false, o1_mmio_bready = false;
+  // ---- as seen at comb_inputs ----
+  AxiTapReq b_rd[TTG_AXI_RD];
+  bool b_rd_resp_ready[TTG_AXI_RD] = {};
+  AxiTapWReq b_wr[TTG_AXI_WR];
+  bool b_wr_resp_ready[TTG_AXI_WR] = {};
+  // ---- outputs after comb_inputs ----
+  bool o2_rd_req_ready[TTG_AXI_RD] = {};
+  bool o2_wr_req_ready[TTG_AXI_WR] = {};
+  AxiTapDdrMaster o2_ddr, o2_mmio;
+  // ---- coverage diagnostics (computed at the end of comb_inputs, not part of any RTL boundary) ----
+  bool dbg_ar_blocked_by_write = false;   // LLC read request present but blocked: pending DDR write to the same line
+  bool dbg_aw_blocked_by_read = false;    // LLC write request present but blocked: pending DDR read of the same line
+  bool dbg_wr_blocked_by_read[TTG_AXI_WR] = {};  // master write request blocked by a same-line read in flight
+  // ---- LLC boundary (final comb() of the tick: the one whose reg_write becomes the next state) ----
+  axi_interconnect::AXI_LLC_ExtIn_t llc_in2;
+  axi_interconnect::AXI_LLC_ExtOut_t llc_out2;
+  AxiTapLlc llc_regs;  // state before this tick's seq
+  // ---- LLC ext_out after the first comb() (comb_outputs); compared with the final one in tests ----
+  axi_interconnect::AXI_LLC_ExtOut_t llc_ext_out1;
+};
+
+struct AxiTap {
+  bool on = false;
+  int cur = 0;  // tick being captured
+  AxiTapTick t[TTG_AXI_TICKS];
+};
+extern AxiTap g_ttg_axi_tap;
+#define TTG_AXI g_ttg_axi_tap
