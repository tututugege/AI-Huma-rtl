--- a/MemSubSystem/include/memsys_tap.h
+++ b/MemSubSystem/include/memsys_tap.h
@@ -0,0 +1,36 @@
+// Read-only recording tap of the memory subsystem (added for the RTL trace harness, refsim only).
+//
+// One CPU cycle = 16 "ticks" (tick 0 = the normal cycle(), ticks 1..15 = run_extra_axi_subsystem_ticks()).
+// The DCache domain (RealDcache + MSHR + WriteBuffer + response latch/forward) runs on every tick, so its
+// boundary is recorded per tick. Active only when $TTG_REC_END is set; it only COPIES values.
+//   spec expressions:  TTG_MS.cur  (tick being replayed, 0..15)
+//                      TTG_MS.t[TTG_MS.cur].<field>
+#pragma once
+#include "IO.h"
+#include "MSHR.h"
+#include "WriteBuffer.h"
+#include <cstdint>
+
+constexpr int TTG_MS_TICKS = 16;
+
+struct MemTapTick {
+  bool valid = false;           // captured this tick
+  bool slow = false;            // tick 0 (CPU-cycle tick: LSU requests injected, route block active)
+  // ---- DCache-domain inputs (after bridges, before dcache_domain_comb_outputs) ----
+  LsuDcacheIO req{};            // request actually presented to DCache this tick (empty on ticks 1..15)
+  MshrAxiIn mshr_in{};
+  WbAxiIn wb_in{};
+  // ---- outputs ----
+  DcacheLsuIO resp_pub{};       // dcache_resp_route_ (published on tick 0 only)
+  MshrAxiOut mshr_out{};        // after dcache_domain_comb_inputs
+  WbAxiOut wb_out{};
+};
+
+struct MemTap {
+  bool on = false;
+  int cur = 0;                  // tick index being captured / replayed
+  uint64_t cycle = 0;
+  MemTapTick t[TTG_MS_TICKS];
+};
+extern MemTap g_ttg_ms_tap;
+#define TTG_MS g_ttg_ms_tap
