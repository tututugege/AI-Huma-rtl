+// memcpu tap: sample the three non-DCache channels (read ICACHE, read EXTRA, write EXTRA) exactly where
+// capture/accumulate_axi_cpu_boundary_state read them; `restored` samples the ports after restore (CPU view).
+void ttg_mc_sample_axi(SimCpu &cpu, McAxiTick &T, bool restored) {
+  if (!g_ttg_mc.on) return;
+  const int rd[2] = {axi_interconnect::MASTER_ICACHE, axi_interconnect::MASTER_EXTRA_R};
+  for (int k = 0; k < 2; ++k) {
+    const auto &p = cpu.axi_interconnect.read_ports[rd[k]];
+    McAxiCh &c = T.ch[k];
+    c.ready = p.req.ready;
+    c.accepted = restored ? p.req.accepted : cpu.axi_interconnect.read_req_accepted[rd[k]];
+    c.accepted_id = restored ? static_cast<uint8_t>(p.req.accepted_id)
+                             : cpu.axi_interconnect.read_req_accepted_id[rd[k]];
+    c.resp_valid = p.resp.valid;
+    c.resp_id = static_cast<uint8_t>(p.resp.id);
+    c.resp_ready = p.resp.ready;
+  }
+  const auto &w = cpu.axi_interconnect.write_ports[axi_interconnect::MASTER_EXTRA_W];
+  McAxiCh &c = T.ch[2];
+  c.ready = w.req.ready;
+  c.accepted = restored ? w.req.accepted
+                        : cpu.axi_interconnect.write_req_accepted[axi_interconnect::MASTER_EXTRA_W];
+  // write accepted_id is not part of the CPU view (the C++ never restores it): recorded as 0 there; raw ticks keep the port id
+  c.accepted_id = restored ? 0 : static_cast<uint8_t>(w.req.id);
+  c.resp_valid = w.resp.valid;
+  c.resp_id = static_cast<uint8_t>(w.resp.id);
+  c.resp_ready = w.resp.ready;
+}
