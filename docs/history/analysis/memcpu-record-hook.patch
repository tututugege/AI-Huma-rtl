diff -urN a/MemSubSystem/include/memcpu_tap.h b/MemSubSystem/include/memcpu_tap.h
--- a/MemSubSystem/include/memcpu_tap.h
+++ b/MemSubSystem/include/memcpu_tap.h
@@ -0,0 +1,77 @@
+// Read-only recording tap of the CPU-phase memory blocks (added for the RTL trace harness, refsim only):
+// MemRouteBlock, MemPtwBlock (walk clients), PeripheralAxi and the CPU-boundary view of the non-DCache AXI master ports.
+//
+// Everything is COPIED at fixed points of one CPU cycle into `cur`; at the end of the cycle `cur` is published into `pub`
+// (and `cur` restarted).  A plugin called by the ordinary mid-cycle hook (ttg_rec::cycle, TTG_REC) in the NEXT cycle therefore
+// reads the complete, final values of the previous cycle from `pub`  (record k is replayed during cycle k+1; the first call sees
+// the idle initial record).  Active only when $TTG_REC is set (g_ttg_mc.on); otherwise every capture point is one bool test.
+//   spec expressions:  TTG_MC.pub.<field>
+#pragma once
+#include "FrontTop.h"
+#include "IO.h"
+#include "MemPtwBlock.h"
+#include "MemRouteBlock.h"
+#include "PeripheralAxi.h"
+#include <cstdint>
+
+// one non-DCache AXI master channel sampled in one internal tick (channel 0: read ICACHE, 1: read EXTRA, 2: write EXTRA)
+struct McAxiCh {
+  bool ready = false;        // port.req.ready (comb value of that tick)
+  bool accepted = false;     // interconnect read_req_accepted / write_req_accepted state after that tick's seq
+  uint8_t accepted_id = 0;   // read: read_req_accepted_id state;  write: port.req.id
+  bool resp_valid = false;   // port.resp.valid (comb value of that tick)
+  uint8_t resp_id = 0;
+  bool resp_ready = false;   // port.resp.ready as driven by the master (meaningful on tick 0)
+};
+struct McAxiTick {
+  McAxiCh ch[3];
+};
+
+struct McCycle {
+  // ---- MemRouteBlock: comb_response side (inputs = published DCache response, outputs = what LSU/ICache/PTW get) ----
+  DcacheLsuIO r_resp_in{};
+  DcacheLsuIO r_lsu_resp{};
+  ICacheMemPortResp r_icache_resp{};
+  PtwEvent r_events{};
+  ReplayWakeup r_wakeup{};
+  // ---- MemRouteBlock: comb_request side ----
+  DCacheReqPorts r_lsu_req{};
+  ICacheMemPortReq r_icache_req{};
+  PtwReq r_walk_req{}, r_dtlb_req{}, r_itlb_req{};
+  LsuDcacheIO r_dcache_req{};
+  PtwGrant r_grant{};
+  // ---- MemPtwBlock ----
+  MemPtwBlock::CombOut p_view{};        // state-only outputs the TLBs read at the start of the cycle (before comb_begin)
+  MemPtwBlock::PortIn p_in{};           // client inputs as latched by comb_begin
+  MemPtwBlock::FeedbackIn p_fb{};       // grant / event / wakeup as applied by comb_finish
+  bool p_issue = false;                 // issue_walk_read / walk_read_addr after comb_begin (what the route block sees)
+  uint32_t p_addr = 0;
+  bool p_flush[2] = {false, false};     // SeqIn.walk_client_flush
+  // ---- PeripheralAxi ----
+  PeripheralReqIO q_req{};
+  PeripheralAxiState q_cur{};           // state before comb_outputs/comb_inputs
+  PeripheralAxiIn q_in{};
+  PeripheralAxiOut q_out{};
+  PeripheralRespIO q_resp{};            // final value of *peripheral_resp after comb_inputs
+  bool q_is_uncached = false;           // address-map decode of q_req.mmio_addr (environment)
+  bool q_is_modeled = false;
+  uint32_t q_env_rdata = 0;             // read data the environment returned for a locally served read (nxt.rdata)
+  // ---- AXI CPU-boundary view (non-DCache masters), per internal tick, and the restored view after tick 15 ----
+  McAxiTick ax[16];
+  McAxiTick view{};                     // after restore_axi_cpu_boundary_state (only ready/accepted/id/resp_* / resp_ready used)
+  McAxiTick exp_view{};                 // = the view restored at the end of the PREVIOUS cycle (what the CPU reads at tick 0)
+  McCycle() {
+    for (int i = 0; i < 2; ++i) p_view.walk_clients[i].req_ready = true;
+    for (int i = 0; i < 2; ++i) p_view.mem_clients[i].req_ready = true;
+    q_resp.ready = true;
+  }
+};
+
+struct McTap {
+  bool on = false;
+  int t = 0;                 // internal tick being replayed by the 16-tick lock-step shell (adapter spec)
+  McCycle cur;
+  McCycle pub;
+};
+extern McTap g_ttg_mc;
+#define TTG_MC g_ttg_mc
